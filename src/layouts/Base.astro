---
import '../styles/global.css';
const { title = 'mantai-signal' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="Daily intelligence on IoT, embedded, traction, and industrial control." />
  <link rel="alternate" type="application/rss+xml" href={`${base}/rss.xml`} title="mantai-signal RSS" />
</head>
<body>
  <div class="container">
    <header class="site">
      <h1><a href={base + '/'}>mantai-signal</a></h1>
      <nav>
        <a href={`${base}/tags/iot/`}>iot</a>
        <a href={`${base}/tags/traction/`}>traction</a>
        <a href={`${base}/tags/hardware/`}>hardware</a>
        <a href={`${base}/tags/security/`}>security</a>
        <a href={`${base}/tags/models/`}>models</a>
      </nav>
    </header>
    <main><slot /></main>
    <div style="margin-top:2rem;padding:1rem;border:1px solid var(--border);border-radius:6px;background:var(--card);">
      <div style="font-size:0.85rem;margin-bottom:0.5rem;">Trigger a fresh pulse (3 commits per click):</div>
      <a
        href="https://github.com/Sentino2/mantai-signal/actions/workflows/manual-tick.yml"
        target="_blank" rel="noopener"
        style="display:inline-block;padding:0.5rem 0.9rem;background:var(--accent);color:#0b0d10;border-radius:4px;font-weight:600;text-decoration:none;"
      >Pulse now →</a>
      <div style="font-size:0.7rem;color:var(--muted);margin-top:0.5rem;">
        Opens the Actions page — click the green <em>Run workflow</em> button there to fire.
      </div>
    </div>
    <footer class="site">
      Curated by a scheduled agent · <a href="https://github.com/Sentino2/mantai-signal">source</a>
    </footer>
  </div>
</body>
</html>
