---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const groups: Record<string, typeof all> = {};
for (const p of all) {
  const key = p.data.date.toISOString().slice(0, 10);
  (groups[key] ||= []).push(p);
}
const base = import.meta.env.BASE_URL;
---
<Base title="mantai-signal">
  {Object.entries(groups).map(([day, items]) => (
    <section class="day-group">
      <h2>{day}</h2>
      {items.map((p) => (
        <article class="card">
          <h3><a href={`${base}/posts/${p.slug}/`}>{p.data.title}</a></h3>
          <div class="meta">{p.data.source} · <a href={p.data.source_url} target="_blank" rel="noopener">source</a></div>
          <div class="tags">
            {p.data.tags.map((t) => <a href={`${base}/tags/${t}/`}>#{t}</a>)}
          </div>
        </article>
      ))}
    </section>
  ))}
  {all.length === 0 && <p style="color:var(--muted)">No posts yet. The next digest run will populate this feed.</p>}
</Base>
