---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL;
---
<Base title={`${post.data.title} · mantai-signal`}>
  <article>
    <h2 style="margin-bottom:0.25rem;">{post.data.title}</h2>
    <div class="meta" style="color:var(--muted);font-size:0.8rem;">
      {post.data.date.toISOString().slice(0,10)} · {post.data.source} ·
      <a href={post.data.source_url} target="_blank" rel="noopener">original source</a>
    </div>
    <div class="tags" style="margin-top:0.5rem;">
      {post.data.tags.map((t) => <a href={`${base}/tags/${t}/`} style="margin-right:0.4rem;color:var(--muted);">#{t}</a>)}
    </div>
    <div class="post-body"><Content /></div>
  </article>
</Base>
